{
    "name": "lakacho/string-helper",
    "description": "Small string helpers: Cyrillic transliteration and URL slugs",
    "type": "library",
    "license": "MIT",
    "keywords": ["slug", "slugify", "transliteration", "string"],
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Lakacho\\StringHelper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lakacho\\StringHelper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
